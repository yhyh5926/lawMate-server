<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
  파일위치: src/main/resources/mapper/CaseMapper.xml
  기능전체: 사건 정보(TB_CASE)와 관련된 모든 SQL 쿼리를 정의합니다.
-->
<mapper namespace="com.edu.springboot.domain.cases.CaseMapper">

    <select id="selectCasesByMemberId" resultType="com.edu.springboot.domain.cases.vo.CaseVO">
        SELECT * FROM TB_CASE WHERE MEMBER_ID = #{memberId} ORDER BY CREATED_AT DESC
    </select>

    <select id="selectCaseById" resultType="com.edu.springboot.domain.cases.vo.CaseVO">
        SELECT * FROM TB_CASE WHERE CASE_ID = #{caseId}
    </select>

    <select id="selectAllCases" resultType="com.edu.springboot.domain.cases.vo.CaseVO">
        SELECT * FROM TB_CASE ORDER BY CREATED_AT DESC
    </select>

    <update id="updateCaseStep">
        UPDATE TB_CASE SET STEP = #{step}, UPDATED_AT = SYSDATE WHERE CASE_ID = #{caseId}
    </update>

</mapper>