<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.springboot.domain.member.MemberMapper">

    <!-- 💡 DB의 대문자 컬럼을 자바의 변수명으로 자동 연결해주는 설정입니다. -->
    <resultMap id="MemberMap" type="com.edu.springboot.domain.member.vo.MemberVO">
        <id property="memberId" column="MEMBER_ID" />
        <result property="loginId" column="LOGIN_ID" />
        <result property="password" column="PASSWORD" />
        <result property="memberType" column="MEMBER_TYPE" />
        <result property="name" column="NAME" />
        <result property="phone" column="PHONE" />
        <result property="email" column="EMAIL" />
        <result property="phoneVerified" column="PHONE_VERIFIED" />
        <result property="status" column="STATUS" />
        <result property="saveIdYn" column="SAVE_ID_YN" />
        <result property="createdAt" column="CREATED_AT" />
        <result property="updatedAt" column="UPDATED_AT" />
    </resultMap>

    <insert id="insertMember" parameterType="com.edu.springboot.domain.member.vo.MemberVO">
        <selectKey keyProperty="memberId" resultType="long" order="BEFORE">
            SELECT SEQ_MEMBER.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO TB_MEMBER (
            MEMBER_ID, LOGIN_ID, PASSWORD, MEMBER_TYPE, NAME, PHONE, EMAIL, 
            PHONE_VERIFIED, STATUS, SAVE_ID_YN, CREATED_AT, UPDATED_AT
        )
        VALUES (
            #{memberId}, #{loginId}, #{password}, #{memberType}, #{name}, #{phone}, #{email}, 
            #{phoneVerified}, #{status}, #{saveIdYn}, SYSDATE, SYSDATE
        )
    </insert>

    <!-- 💡 반드시 resultMap="MemberMap"을 사용해야 PASSWORD 정보를 정확히 가져옵니다. -->
    <select id="findByLoginId" resultMap="MemberMap">
        SELECT * FROM TB_MEMBER WHERE LOGIN_ID = #{loginId} AND STATUS != 'WITHDRAWN'
    </select>

    <update id="updateMember" parameterType="com.edu.springboot.domain.member.vo.MemberVO">
        UPDATE TB_MEMBER SET EMAIL = #{email}, PHONE = #{phone}, UPDATED_AT = SYSDATE WHERE MEMBER_ID = #{memberId}
    </update>

</mapper>