<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.edu.springboot.domain.question.QuestionMapper">

    <resultMap id="questionListMap" type="com.edu.springboot.domain.question.vo.QuestionVO">
        <id property="questionId" column="QUESTION_ID" />
        <result property="memberId" column="MEMBER_ID" />
        <result property="memberName" column="MEMBER_NAME" />
        <result property="title" column="TITLE" />
        <result property="caseType" column="CASE_TYPE" />
        <result property="status" column="STATUS" />
        <result property="createdAt" column="CREATED_AT" />
        <result property="answerCount" column="ANSWER_COUNT" />
    </resultMap>

    <resultMap id="questionDetailMap" type="com.edu.springboot.domain.question.vo.QuestionVO">
        <id property="questionId" column="QUESTION_ID" />
        <result property="memberId" column="MEMBER_ID" />
        <result property="memberName" column="MEMBER_NAME" />
        <result property="caseId" column="CASE_ID" />
        <result property="title" column="TITLE" />
        <result property="content" column="CONTENT" />
        <result property="caseType" column="CASE_TYPE" />
        <result property="assignedLawyer" column="ASSIGNED_LAWYER" />
        <result property="status" column="STATUS" />
        <result property="createdAt" column="CREATED_AT" />
        <result property="updatedAt" column="UPDATED_AT" />
        
        <collection property="answers" ofType="com.edu.springboot.domain.answer.vo.AnswerVO">
            <id property="answerId" column="ANSWER_ID" />
            <result property="content" column="ANSWER_CONTENT" />
            <result property="createdAt" column="ANSWER_CREATED_AT" />
            <result property="lawyerId" column="LAWYER_ID" />
            <result property="lawyerName" column="LAWYER_NAME" />
            <result property="isAdopted" column="IS_ADOPTED" />
        </collection>
    </resultMap>

    <select id="selectQuestionsWithPaging" parameterType="map" resultMap="questionListMap">
        SELECT 
            q.QUESTION_ID, q.MEMBER_ID, m.NAME AS MEMBER_NAME,
            q.TITLE, q.CASE_TYPE, q.STATUS, q.CREATED_AT,
            (SELECT COUNT(*) FROM TB_ANSWER a WHERE a.QUESTION_ID = q.QUESTION_ID) AS ANSWER_COUNT
        FROM TB_QUESTION q
        LEFT OUTER JOIN TB_MEMBER m ON q.MEMBER_ID = m.MEMBER_ID
        <where>
            <if test="caseType != null and caseType != ''">
                AND q.CASE_TYPE = #{caseType}
            </if>
            <if test="title != null and title != ''">
                AND q.TITLE LIKE '%' || #{title} || '%'
            </if>
        </where>
        ORDER BY q.CREATED_AT DESC
        OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <select id="selectQuestionCount" parameterType="map" resultType="int">
        SELECT COUNT(*)
        FROM TB_QUESTION q
        <where>
            <if test="caseType != null and caseType != ''">
                AND q.CASE_TYPE = #{caseType}
            </if>
            <if test="title != null and title != ''">
                AND q.TITLE LIKE '%' || #{title} || '%'
            </if>
        </where>
    </select>

    <select id="selectQuestionById" resultMap="questionDetailMap">
        SELECT
            q.QUESTION_ID, q.MEMBER_ID, qm.NAME as MEMBER_NAME,
            q.CASE_ID, q.TITLE, q.CONTENT, q.CASE_TYPE, q.ASSIGNED_LAWYER,
            q.STATUS, q.CREATED_AT, q.UPDATED_AT,
            a.ANSWER_ID, a.CONTENT as ANSWER_CONTENT, a.CREATED_AT as ANSWER_CREATED_AT,
            a.LAWYER_ID, a.IS_ADOPTED, m.NAME as LAWYER_NAME
        FROM TB_QUESTION q
        LEFT OUTER JOIN TB_MEMBER qm ON q.MEMBER_ID = qm.MEMBER_ID
        LEFT OUTER JOIN TB_ANSWER a ON q.QUESTION_ID = a.QUESTION_ID
        LEFT OUTER JOIN TB_LAWYER l ON a.LAWYER_ID = l.LAWYER_ID
        LEFT OUTER JOIN TB_MEMBER m ON l.MEMBER_ID = m.MEMBER_ID
        WHERE q.QUESTION_ID = #{questionId}
        ORDER BY a.CREATED_AT DESC
    </select>

</mapper>