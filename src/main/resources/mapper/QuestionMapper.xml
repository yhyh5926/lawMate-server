<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
  파일위치: src/main/resources/mapper/QuestionMapper.xml
  수정사항: TB_QUESTION 테이블 명칭과 SEQ_QUESTION 시퀀스를 적용했습니다.
-->
<mapper namespace="com.edu.springboot.domain.question.QuestionMapper">

    <!-- 법률 질문 등록 -->
    <insert id="insertQuestion" parameterType="com.edu.springboot.domain.question.vo.QuestionVO">
        <selectKey keyProperty="questionId" resultType="long" order="BEFORE">
            SELECT SEQ_QUESTION.NEXTVAL FROM DUAL
        </selectKey>
        INSERT INTO TB_QUESTION (
            QUESTION_ID, MEMBER_ID, CASE_ID, TITLE, CONTENT, CASE_TYPE, STATUS, CREATED_AT, UPDATED_AT
        )
        VALUES (
            #{questionId}, #{memberId}, #{caseId}, #{title}, #{content}, #{caseType}, 'OPEN', SYSDATE, SYSDATE
        )
    </insert>

    <!-- 전체 질문 목록 조회 -->
    <select id="selectAllQuestions" resultType="com.edu.springboot.domain.question.vo.QuestionVO">
        SELECT * FROM TB_QUESTION ORDER BY CREATED_AT DESC
    </select>

    <!-- 질문 상세 조회 -->
    <select id="selectQuestionById" resultType="com.edu.springboot.domain.question.vo.QuestionVO">
        SELECT * FROM TB_QUESTION WHERE QUESTION_ID = #{questionId}
    </select>

</mapper>